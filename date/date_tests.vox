'check moment' with "yesterday" and {'the moment of' with 2026 and 9 and 26} and {'the moment described by' of "yesterday" and 'the base moment'}.
(date -u -d '3 days' vs -3 days, +3 days, plain 3 days - all relative to the sandbox's own clock, so only the SHAPE is checked here against this library's own 'days later')
'check moment' with "a bare count means forward" and {'days later' of 'the base moment' and 3} and {'the moment described by' of "3 days" and 'the base moment'}.
'check moment' with "an explicit plus" and {'days later' of 'the base moment' and 3} and {'the moment described by' of "+3 days" and 'the base moment'}.
'check moment' with "an explicit minus" and {'days later' of 'the base moment' and -3} and {'the moment described by' of "-3 days" and 'the base moment'}.
