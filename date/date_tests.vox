'check moment' with "weeks ago" and {'weeks later' of 'the base moment' and -3} and {'the moment described by' of "3 weeks ago" and 'the base moment'}.
'check moment' with "months ago" and {'months later' of 'the base moment' and -2} and {'the moment described by' of "2 months ago" and 'the base moment'}.
'check moment' with "minutes ago" and {'minutes later' of 'the base moment' and -1} and {'the moment described by' of "1 minute ago" and 'the base moment'}.
'check moment' with "a singular unit" and {'seconds later' of 'the base moment' and 1} and {'the moment described by' of "1 second" and 'the base moment'}.
'check moment' with "hours, plural" and {'hours later' of 'the base moment' and -5} and {'the moment described by' of "5 hours ago" and 'the base moment'}.
'check moment' with "next <unit> means 1" and {'days later' of 'the base moment' and 1} and {'the moment described by' of "next day" and 'the base moment'}.
'check moment' with "last <unit> means -1" and {'days later' of 'the base moment' and -1} and {'the moment described by' of "last day" and 'the base moment'}.
'check moment' with "next week" and {'weeks later' of 'the base moment' and 1} and {'the moment described by' of "next week" and 'the base moment'}.
'check moment' with "next year" and {'years later' of 'the base moment' and 1} and {'the moment described by' of "next year" and 'the base moment'}.
'check moment' with "a bare weekday on or after, same day since the base is that weekday" and {'the moment of' with 2026 and 9 and 27} and {'the moment described by' of "sunday" and 'the base moment'}.
'check moment' with "a bare weekday on or after, forward to the next one" and {'the moment of' with 2026 and 9 and 30} and {'the moment described by' of "wednesday" and 'the base moment'}.
'check moment' with "next <weekday> is strictly after, even on that weekday" and {'the moment of' with 2026 and 10 and 4} and {'the moment described by' of "next sunday" and 'the base moment'}.
'check moment' with "last <weekday> is strictly before, even on that weekday" and {'the moment of' with 2026 and 9 and 20} and {'the moment described by' of "last sunday" and 'the base moment'}.
