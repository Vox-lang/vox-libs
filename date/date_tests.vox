check with "%j" and "210" and {'the moment written as' of 'the fixed moment' and "%j"}.
check with "%V" and "31" and {'the moment written as' of 'the fixed moment' and "%V"}.
check with "%G" and "2026" and {'the moment written as' of 'the fixed moment' and "%G"}.
check with "%q" and "3" and {'the moment written as' of 'the fixed moment' and "%q"}.
check with "%C" and "20" and {'the moment written as' of 'the fixed moment' and "%C"}.
check with "%u" and "3" and {'the moment written as' of 'the fixed moment' and "%u"}.
check with "%a" and "Wed" and {'the moment written as' of 'the fixed moment' and "%a"}.
check with "%A" and "Wednesday" and {'the moment written as' of 'the fixed moment' and "%A"}.
check with "%b" and "Jul" and {'the moment written as' of 'the fixed moment' and "%b"}.
check with "%B" and "July" and {'the moment written as' of 'the fixed moment' and "%B"}.
check with "%p" and "PM" and {'the moment written as' of 'the fixed moment' and "%p"}.
check with "%P" and "pm" and {'the moment written as' of 'the fixed moment' and "%P"}.
check with "%z" and "+0000" and {'the moment written as' of 'the fixed moment' and "%z"}.
check with "%Z" and "UTC" and {'the moment written as' of 'the fixed moment' and "%Z"}.
check with "%s" and "1785340968" and {'the moment written as' of 'the fixed moment' and "%s"}.
check with "%e" and "29" and {'the moment written as' of 'the fixed moment' and "%e"}.
check with "%k" and "16" and {'the moment written as' of 'the fixed moment' and "%k"}.
check with "%l" and " 4" and {'the moment written as' of 'the fixed moment' and "%l"}.
check with "%I" and "04" and {'the moment written as' of 'the fixed moment' and "%I"}.
check with "%r" and "04:02:48 PM" and {'the moment written as' of 'the fixed moment' and "%r"}.
check with "%R" and "16:02" and {'the moment written as' of 'the fixed moment' and "%R"}.
check with "%T" and "16:02:48" and {'the moment written as' of 'the fixed moment' and "%T"}.
check with "%D" and "07/29/26" and {'the moment written as' of 'the fixed moment' and "%D"}.
check with "%F" and "2026-07-29" and {'the moment written as' of 'the fixed moment' and "%F"}.
check with "%x" and "07/29/26" and {'the moment written as' of 'the fixed moment' and "%x"}.
check with "%X" and "16:02:48" and {'the moment written as' of 'the fixed moment' and "%X"}.
check with "%c" and "Wed Jul 29 16:02:48 2026" and {'the moment written as' of 'the fixed moment' and "%c"}.
check with "%h" and "Jul" and {'the moment written as' of 'the fixed moment' and "%h"}.
check with "%w" and "3" and {'the moment written as' of 'the fixed moment' and "%w"}.
check with "%U" and "30" and {'the moment written as' of 'the fixed moment' and "%U"}.
check with "%W" and "30" and {'the moment written as' of 'the fixed moment' and "%W"}.
check with "%g" and "26" and {'the moment written as' of 'the fixed moment' and "%g"}.
check with "%%" and "%" and {'the moment written as' of 'the fixed moment' and "%%"}.
check with "%n is a newline" and "\n" and {'the moment written as' of 'the fixed moment' and "%n"}.
check with "%t is a tab" and "\t" and {'the moment written as' of 'the fixed moment' and "%t"}.
check with "an unknown specifier is copied through" and "%Q" and {'the moment written as' of 'the fixed moment' and "%Q"}.
check with "a literal layout is untouched" and "hello" and {'the moment written as' of 'the fixed moment' and "hello"}.
check with "a full layout mixes literals and specifiers" and "2026-07-29 16:02:48" and {'the moment written as' of 'the fixed moment' and "%Y-%m-%d %H:%M:%S"}.

Print "-- writing a moment out: the padding and case flags --".
(a single-digit moment shows padding: date -u -d '2026-01-05 05:03:07' '+[%-d][%_d][%0d][%03d][%5d][%_3H]')
a number called 'a small moment' is {'the moment at' with 2026 and 1 and 5 and 5 and 3 and 7}.
check with "- suppresses the default zero pad" and "5" and {'the moment written as' of 'a small moment' and "%-d"}.
check with "_ pads with a space" and " 5" and {'the moment written as' of 'a small moment' and "%_d"}.
check with "0 pads with a zero" and "05" and {'the moment written as' of 'a small moment' and "%0d"}.
check with "a width alone keeps the default pad character" and "005" and {'the moment written as' of 'a small moment' and "%03d"}.
check with "a wider width still zero-pads %d by default" and "00005" and {'the moment written as' of 'a small moment' and "%5d"}.
check with "a width on a space-padded field" and "  5" and {'the moment written as' of 'a small moment' and "%_3H"}.
(date -u -d '2026-01-05' '+[%^a][%#a][%^p][%#p][%#Z]')
check with "^ upper-cases a short weekday name" and "MON" and {'the moment written as' of 'a small moment' and "%^a"}.
check with "# also upper-cases a title-cased name" and "MON" and {'the moment written as' of 'a small moment' and "%#a"}.
check with "^ leaves an already-upper %p alone" and "AM" and {'the moment written as' of 'a small moment' and "%^p"}.
check with "# lower-cases %p" and "am" and {'the moment written as' of 'a small moment' and "%#p"}.
check with "# lower-cases %Z" and "utc" and {'the moment written as' of 'a small moment' and "%#Z"}.
(date -u -d '2026-01-05 05:03:07' '+%012s' -> 001767589387)
check with "0 with a wide width pads %s, which is unpadded by default" and "001767589387" and {'the moment written as' of 'a small moment' and "%012s"}.

Print "-- writing a moment out: the convenience exports --".
(date -Iseconds -u -d '@1785340968'; date --rfc-3339=seconds -u -d '@1785340968'; date -R -u -d '@1785340968'; date -u -d '@1785340968')
check with "the date of" and "2026-07-29" and "{'the date of' of 'the fixed moment'}".
check with "the date and time of" and "2026-07-29T16:02:48+00:00" and "{'the date and time of' of 'the fixed moment'}".
check with "the rfc 3339 date and time of" and "2026-07-29 16:02:48+00:00" and "{'the rfc 3339 date and time of' of 'the fixed moment'}".
check with "the rfc email date of" and "Wed, 29 Jul 2026 16:02:48 +0000" and "{'the rfc email date of' of 'the fixed moment'}".
check with "the moment in words of" and "Wed Jul 29 16:02:48 UTC 2026" and "{'the moment in words of' of 'the fixed moment'}".

Print "-- reading a moment in: accepted forms --".
'check moment' with "a plain date" and {'the moment of' with 2026 and 7 and 29} and {'the moment read from' of "2026-07-29"}.
'check moment' with "a date and time, space separated" and 'the fixed moment' and {'the moment read from' of "2026-07-29 16:02:48"}.
'check moment' with "a date and time, T separated" and 'the fixed moment' and {'the moment read from' of "2026-07-29T16:02:48"}.
