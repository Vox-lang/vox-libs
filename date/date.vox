  a number called 'the quarter' is 'the quarter of' of moment.
  a number called 'the century' is 'the century of' of moment.
  a number called 'the short year' is 'floor modulo' with 'the year' and 100.
  a number called 'the short iso week year' is 'floor modulo' with 'the iso week year' and 100.
  a number called 'the twelve hour' is 'the twelve hour of' of moment.
  a number called 'the sunday week' is 'the sunday week of' of moment.
  a number called 'the monday week' is 'the monday week of' of moment.
  a number called 'the sunday based weekday' is 'the day of week sunday based of' of moment.
  a text called 'the month name' is 'the month name of' of 'the month'.
  a text called 'the short month name' is 'the short month name of' of 'the month'.
  a text called 'the weekday name' is 'the weekday name of' of 'the weekday'.
  a text called 'the short weekday name' is 'the short weekday name of' of 'the weekday'.
  a text called 'the am or pm' is 'the am or pm of' of moment.
  a text called 'the year text' is "{'the year'}".
  a text called 'the short year text' is "{'the short year'}".
  a text called 'the month text' is "{'the month'}".
  a text called 'the day of month text' is "{'the day of month'}".
  a text called 'the hour text' is "{'the hour'}".
  a text called 'the twelve hour text' is "{'the twelve hour'}".
  a text called 'the minute text' is "{'the minute'}".
  a text called 'the second text' is "{'the second'}".
  a text called 'the weekday text' is "{'the weekday'}".
  a text called 'the sunday based weekday text' is "{'the sunday based weekday'}".
  a text called 'the day of year text' is "{'the day of year'}".
  a text called 'the sunday week text' is "{'the sunday week'}".
  a text called 'the monday week text' is "{'the monday week'}".
  a text called 'the iso week text' is "{'the iso week'}".
  a text called 'the iso week year text' is "{'the iso week year'}".
  a text called 'the short iso week year text' is "{'the short iso week year'}".
  a text called 'the quarter text' is "{'the quarter'}".
  a text called 'the century text' is "{'the century'}".
  a text called 'the moment text' is "{moment}".
  If spec is 'Y' then, 'render specifier' with output and 'the year text' and 4 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'y' then, 'render specifier' with output and 'the short year text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'm' then, 'render specifier' with output and 'the month text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'd' then, 'render specifier' with output and 'the day of month text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'e' then, 'render specifier' with output and 'the day of month text' and 2 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'H' then, 'render specifier' with output and 'the hour text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'k' then, 'render specifier' with output and 'the hour text' and 2 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'I' then, 'render specifier' with output and 'the twelve hour text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'l' then, 'render specifier' with output and 'the twelve hour text' and 2 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'M' then, 'render specifier' with output and 'the minute text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'S' then, 'render specifier' with output and 'the second text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'j' then, 'render specifier' with output and 'the day of year text' and 3 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'u' then, 'render specifier' with output and 'the weekday text' and 1 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'w' then, 'render specifier' with output and 'the sunday based weekday text' and 1 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'U' then, 'render specifier' with output and 'the sunday week text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'W' then, 'render specifier' with output and 'the monday week text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'V' then, 'render specifier' with output and 'the iso week text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'G' then, 'render specifier' with output and 'the iso week year text' and 4 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'g' then, 'render specifier' with output and 'the short iso week year text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'q' then, 'render specifier' with output and 'the quarter text' and 1 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'C' then, 'render specifier' with output and 'the century text' and 2 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 's' then, 'render specifier' with output and 'the moment text' and 0 and '0' and 'pad flag' and width, Return a boolean, true.
  If spec is 'a' then, a text called 'a cased' is 'cased for a title' with 'the short weekday name' and 'case flag', 'render specifier' with output and 'a cased' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'A' then, a text called 'a cased' is 'cased for a title' with 'the weekday name' and 'case flag', 'render specifier' with output and 'a cased' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'b' then, a text called 'a cased' is 'cased for a title' with 'the short month name' and 'case flag', 'render specifier' with output and 'a cased' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'B' then, a text called 'a cased' is 'cased for a title' with 'the month name' and 'case flag', 'render specifier' with output and 'a cased' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'h' then, Return a boolean, {'write a specifier' with output and moment and 'b' and 'pad flag' and 'case flag' and width}.
  If spec is 'p' then, a text called 'a cased' is 'cased for upper' with 'the am or pm' and 'case flag', 'render specifier' with output and 'a cased' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'P' then, a text called 'p lowered' is 'lowercase text' of 'the am or pm', 'render specifier' with output and 'p lowered' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'Z' then, a text called 'z cased' is 'cased for upper' with "UTC" and 'case flag', 'render specifier' with output and 'z cased' and 0 and ' ' and 'pad flag' and width, Return a boolean, true.
  If spec is 'z' then, append "+0000" to output, Return a boolean, true.
  If spec is 'n' then, 'write the byte' with '\n' and output, Return a boolean, true.
  If spec is 't' then, 'write the byte' with '\t' and output, Return a boolean, true.
  If spec is '%' then, 'write the byte' with '%' and output, Return a boolean, true.
  If spec is 'R' then, 'write a specifier' with output and moment and 'H' and 0 and 0 and -1, 'write the byte' with ':' and output, 'write a specifier' with output and moment and 'M' and 0 and 0 and -1, Return a boolean, true.
  If spec is 'T' then, 'write a specifier' with output and moment and 'H' and 0 and 0 and -1, 'write the byte' with ':' and output, 'write a specifier' with output and moment and 'M' and 0 and 0 and -1, 'write the byte' with ':' and output, 'write a specifier' with output and moment and 'S' and 0 and 0 and -1, Return a boolean, true.
  If spec is 'X' then, Return a boolean, {'write a specifier' with output and moment and 'T' and 0 and 0 and -1}.
  If spec is 'D' then, 'write a specifier' with output and moment and 'm' and 0 and 0 and -1, 'write the byte' with '/' and output, 'write a specifier' with output and moment and 'd' and 0 and 0 and -1, 'write the byte' with '/' and output, 'write a specifier' with output and moment and 'y' and 0 and 0 and -1, Return a boolean, true.
  If spec is 'x' then, Return a boolean, {'write a specifier' with output and moment and 'D' and 0 and 0 and -1}.
  If spec is 'F' then, 'write a specifier' with output and moment and 'Y' and 0 and 0 and -1, 'write the byte' with '-' and output, 'write a specifier' with output and moment and 'm' and 0 and 0 and -1, 'write the byte' with '-' and output, 'write a specifier' with output and moment and 'd' and 0 and 0 and -1, Return a boolean, true.
  If spec is 'r' then, 'write a specifier' with output and moment and 'I' and 0 and 0 and -1, 'write the byte' with ':' and output, 'write a specifier' with output and moment and 'M' and 0 and 0 and -1, 'write the byte' with ':' and output, 'write a specifier' with output and moment and 'S' and 0 and 0 and -1, 'write the byte' with ' ' and output, 'write a specifier' with output and moment and 'p' and 0 and 0 and -1, Return a boolean, true.
  If spec is 'c' then, 'write a specifier' with output and moment and 'a' and 0 and 0 and -1, 'write the byte' with ' ' and output, 'write a specifier' with output and moment and 'b' and 0 and 0 and -1, 'write the byte' with ' ' and output, 'write a specifier' with output and moment and 'e' and 0 and 0 and -1, 'write the byte' with ' ' and output, 'write a specifier' with output and moment and 'T' and 0 and 0 and -1, 'write the byte' with ' ' and output, 'write a specifier' with output and moment and 'Y' and 0 and 0 and -1, Return a boolean, true.
